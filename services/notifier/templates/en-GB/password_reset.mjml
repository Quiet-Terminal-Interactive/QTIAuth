---
subject: "Reset your {{product_name}} password"
vars: [name, reset_url, expires_minutes, username]
---
<mjml>
  <mj-head>
    <mj-preview>Reset your {{product_name}} password</mj-preview>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{colors.background}}" width="560px">
    {{> header}}
    <mj-section background-color="{{colors.surface}}" border-radius="14px" padding="28px 8px">
      <mj-column>
        <mj-text color="{{colors.text}}" font-size="22px" font-weight="700" line-height="30px">Reset your password</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">Hi {{name}}, we got a request to reset the password for {{#if username}}<strong>{{username}}</strong>{{else}}your account{{/if}}. The link expires in {{expires_minutes}} minutes.</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">When you reset it you'll be signed out everywhere else unless you choose otherwise.</mj-text>
        <mj-button href="{{reset_url}}" background-color="{{colors.primary}}" color="{{colors.primary_text}}" font-weight="600" border-radius="8px" align="left" inner-padding="12px 22px">Choose a new password</mj-button>
        <mj-text color="{{colors.text_muted}}" font-size="13px" line-height="20px">If you didn't ask for this, you can ignore this email.</mj-text>
      </mj-column>
    </mj-section>
    {{> footer}}
  </mj-body>
</mjml>
