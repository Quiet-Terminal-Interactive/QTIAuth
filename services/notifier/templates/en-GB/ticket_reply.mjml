---
subject: "New reply on ticket #{{number}}"
vars: [name, number, subject, ticket_url]
---
<mjml>
  <mj-head>
    <mj-preview>New reply on ticket #{{number}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{colors.background}}" width="560px">
    {{> header}}
    <mj-section background-color="{{colors.surface}}" border-radius="14px" padding="28px 8px">
      <mj-column>
        <mj-text color="{{colors.text}}" font-size="22px" font-weight="700" line-height="30px">New reply on your ticket</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">Hi {{name}}, there's a new reply on <strong>#{{number}}</strong> ({{subject}}).</mj-text>
        <mj-button href="{{ticket_url}}" background-color="{{colors.primary}}" color="{{colors.primary_text}}" font-weight="600" border-radius="8px" align="left" inner-padding="12px 22px">Read the reply</mj-button>
        <mj-text color="{{colors.text_muted}}" font-size="13px" line-height="20px">For your security we don't include the reply text in emails.</mj-text>
      </mj-column>
    </mj-section>
    {{> footer}}
  </mj-body>
</mjml>
