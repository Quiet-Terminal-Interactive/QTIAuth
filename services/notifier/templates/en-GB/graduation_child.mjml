---
subject: "You can now manage your own account"
vars: [name, optional_at, settings_url]
---
<mjml>
  <mj-head>
    <mj-preview>You can now manage your own account</mj-preview>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{colors.background}}" width="560px">
    {{> header}}
    <mj-section background-color="{{colors.surface}}" border-radius="14px" padding="28px 8px">
      <mj-column>
        <mj-text color="{{colors.text}}" font-size="22px" font-weight="700" line-height="30px">Happy birthday!</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">Hi {{name}}, you've reached the age where you can manage your own account. Your guardian's controls stay in place until {{optional_at}}, then they become optional.</mj-text>
        <mj-button href="{{settings_url}}" background-color="{{colors.primary}}" color="{{colors.primary_text}}" font-weight="600" border-radius="8px" align="left" inner-padding="12px 22px">Open settings</mj-button>
      </mj-column>
    </mj-section>
    {{> footer}}
  </mj-body>
</mjml>
