---
subject: "Your appeal was reviewed"
vars: [name, outcome, details]
---
<mjml>
  <mj-head>
    <mj-preview>Your appeal was reviewed</mj-preview>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{colors.background}}" width="560px">
    {{> header}}
    <mj-section background-color="{{colors.surface}}" border-radius="14px" padding="28px 8px">
      <mj-column>
        <mj-text color="{{colors.text}}" font-size="22px" font-weight="700" line-height="30px">Your appeal was reviewed</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">Hi {{name}}, we reviewed your appeal. Outcome: <strong>{{outcome}}</strong>.</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">{{details}}</mj-text>

      </mj-column>
    </mj-section>
    {{> footer}}
  </mj-body>
</mjml>
