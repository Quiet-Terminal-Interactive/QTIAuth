---
subject: "Your key batch is ready"
vars: [name, label, count]
---
<mjml>
  <mj-head>
    <mj-preview>Your key batch is ready</mj-preview>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{colors.background}}" width="560px">
    {{> header}}
    <mj-section background-color="{{colors.surface}}" border-radius="14px" padding="28px 8px">
      <mj-column>
        <mj-text color="{{colors.text}}" font-size="22px" font-weight="700" line-height="30px">Key batch ready</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">Hi {{name}}, the key batch <strong>{{label}}</strong> ({{count}} keys) was generated.</mj-text>

      </mj-column>
    </mj-section>
    {{> footer}}
  </mj-body>
</mjml>
