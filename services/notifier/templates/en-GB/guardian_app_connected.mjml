---
subject: "{{child_name}} connected {{client_name}}"
vars: [child_name, client_name, scopes, dashboard_url]
---
<mjml>
  <mj-head>
    <mj-preview>{{child_name}} connected {{client_name}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{colors.background}}" width="560px">
    {{> header}}
    <mj-section background-color="{{colors.surface}}" border-radius="14px" padding="28px 8px">
      <mj-column>
        <mj-text color="{{colors.text}}" font-size="22px" font-weight="700" line-height="30px">New app connected</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">{{child_name}} connected <strong>{{client_name}}</strong> to their account. It can: {{scopes}}.</mj-text>
        <mj-button href="{{dashboard_url}}" background-color="{{colors.primary}}" color="{{colors.primary_text}}" font-weight="600" border-radius="8px" align="left" inner-padding="12px 22px">Open family dashboard</mj-button>
      </mj-column>
    </mj-section>
    {{> footer}}
  </mj-body>
</mjml>
