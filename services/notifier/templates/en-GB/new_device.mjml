---
subject: "New sign-in to your {{product_name}} account"
vars: [name, device, location, time, ip]
---
<mjml>
  <mj-head>
    <mj-preview>New sign-in to your {{product_name}} account</mj-preview>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{colors.background}}" width="560px">
    {{> header}}
    <mj-section background-color="{{colors.surface}}" border-radius="14px" padding="28px 8px">
      <mj-column>
        <mj-text color="{{colors.text}}" font-size="22px" font-weight="700" line-height="30px">New sign-in</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">Hi {{name}}, your account was just used to sign in from <strong>{{device}}</strong>, near <strong>{{location}}</strong>.</mj-text>

        <mj-text color="{{colors.text_muted}}" font-size="13px" line-height="20px">If this wasn't you, reset your password and review your sessions straight away.</mj-text>
      </mj-column>
    </mj-section>
    {{> footer}}
  </mj-body>
</mjml>
