---
subject: "Ticket #{{number}} is now {{status}}"
vars: [name, number, subject, status, ticket_url]
---
<mjml>
  <mj-head>
    <mj-preview>Ticket #{{number}} is now {{status}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{colors.background}}" width="560px">
    {{> header}}
    <mj-section background-color="{{colors.surface}}" border-radius="14px" padding="28px 8px">
      <mj-column>
        <mj-text color="{{colors.text}}" font-size="22px" font-weight="700" line-height="30px">Ticket #{{number}} updated</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">Hi {{name}}, your ticket ({{subject}}) is now <strong>{{status}}</strong>.</mj-text>
        <mj-button href="{{ticket_url}}" background-color="{{colors.primary}}" color="{{colors.primary_text}}" font-weight="600" border-radius="8px" align="left" inner-padding="12px 22px">View ticket</mj-button>
      </mj-column>
    </mj-section>
    {{> footer}}
  </mj-body>
</mjml>
