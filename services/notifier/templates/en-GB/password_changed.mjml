---
subject: "Your {{product_name}} password was changed"
vars: [name, method]
---
<mjml>
  <mj-head>
    <mj-preview>Your {{product_name}} password was changed</mj-preview>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{colors.background}}" width="560px">
    {{> header}}
    <mj-section background-color="{{colors.surface}}" border-radius="14px" padding="28px 8px">
      <mj-column>
        <mj-text color="{{colors.text}}" font-size="22px" font-weight="700" line-height="30px">Your password was changed</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">Hi {{name}}, the password for your account was just changed.</mj-text>

        <mj-text color="{{colors.text_muted}}" font-size="13px" line-height="20px">If this wasn't you, reset your password and review your sessions straight away.</mj-text>
      </mj-column>
    </mj-section>
    {{> footer}}
  </mj-body>
</mjml>
