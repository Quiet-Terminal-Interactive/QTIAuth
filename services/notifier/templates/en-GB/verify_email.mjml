---
subject: "Confirm your email for {{product_name}}"
vars: [name, verify_url]
---
<mjml>
  <mj-head>
    <mj-preview>Confirm your email for {{product_name}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{colors.background}}" width="560px">
    {{> header}}
    <mj-section background-color="{{colors.surface}}" border-radius="14px" padding="28px 8px">
      <mj-column>
        <mj-text color="{{colors.text}}" font-size="22px" font-weight="700" line-height="30px">Confirm your email</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">Hi {{name}}, confirm this address to finish setting up your {{product_name}} account.</mj-text>
        <mj-button href="{{verify_url}}" background-color="{{colors.primary}}" color="{{colors.primary_text}}" font-weight="600" border-radius="8px" align="left" inner-padding="12px 22px">Confirm email</mj-button>
        <mj-text color="{{colors.text_muted}}" font-size="13px" line-height="20px">If you didn't ask for this, you can ignore this email.</mj-text>
      </mj-column>
    </mj-section>
    {{> footer}}
  </mj-body>
</mjml>
