---
subject: "We got your report"
vars: [name, reference]
---
<mjml>
  <mj-head>
    <mj-preview>We got your report</mj-preview>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{colors.background}}" width="560px">
    {{> header}}
    <mj-section background-color="{{colors.surface}}" border-radius="14px" padding="28px 8px">
      <mj-column>
        <mj-text color="{{colors.text}}" font-size="22px" font-weight="700" line-height="30px">Thanks for your report</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">Hi {{name}}, we got your report (reference {{reference}}). We'll review it and let you know the outcome. The person you reported won't be told who reported them.</mj-text>

      </mj-column>
    </mj-section>
    {{> footer}}
  </mj-body>
</mjml>
