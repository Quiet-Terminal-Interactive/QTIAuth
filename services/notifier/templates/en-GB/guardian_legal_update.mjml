---
subject: "We've updated our {{title}}"
vars: [child_name, title, summary, material, url]
---
<mjml>
  <mj-head>
    <mj-preview>We've updated our {{title}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{colors.background}}" width="560px">
    {{> header}}
    <mj-section background-color="{{colors.surface}}" border-radius="14px" padding="28px 8px">
      <mj-column>
        <mj-text color="{{colors.text}}" font-size="22px" font-weight="700" line-height="30px">We've updated our {{title}}</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">{{summary}}</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">{{#if material}}As {{child_name}}'s guardian, please review and accept the changes from the family dashboard.{{/if}}</mj-text>
        <mj-button href="{{url}}" background-color="{{colors.primary}}" color="{{colors.primary_text}}" font-weight="600" border-radius="8px" align="left" inner-padding="12px 22px">Read it</mj-button>
      </mj-column>
    </mj-section>
    {{> footer}}
  </mj-body>
</mjml>
