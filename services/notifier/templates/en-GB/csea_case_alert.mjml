---
subject: "Restricted: a new case needs review"
vars: [case_url]
---
<mjml>
  <mj-head>
    <mj-preview>Restricted: a new case needs review</mj-preview>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{colors.background}}" width="560px">
    {{> header}}
    <mj-section background-color="{{colors.surface}}" border-radius="14px" padding="28px 8px">
      <mj-column>
        <mj-text color="{{colors.text}}" font-size="22px" font-weight="700" line-height="30px">A restricted case needs review</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">A new restricted case was opened. Open it from the moderation console with the right access.</mj-text>
        <mj-button href="{{case_url}}" background-color="{{colors.primary}}" color="{{colors.primary_text}}" font-weight="600" border-radius="8px" align="left" inner-padding="12px 22px">Open case</mj-button>
      </mj-column>
    </mj-section>
    {{> footer}}
  </mj-body>
</mjml>
