---
subject: "Your verification code: {{code}}"
vars: [code, expires_minutes]
---
<mjml>
  <mj-head>
    <mj-preview>Your verification code: {{code}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{colors.background}}" width="560px">
    {{> header}}
    <mj-section background-color="{{colors.surface}}" border-radius="14px" padding="28px 8px">
      <mj-column>
        <mj-text color="{{colors.text}}" font-size="22px" font-weight="700" line-height="30px">Your verification code</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">Enter this code to continue: <strong style="font-size: 22px; letter-spacing: 3px;">{{code}}</strong></mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">It expires in {{expires_minutes}} minutes.</mj-text>

        <mj-text color="{{colors.text_muted}}" font-size="13px" line-height="20px">If you didn't ask for this, you can ignore this email.</mj-text>
      </mj-column>
    </mj-section>
    {{> footer}}
  </mj-body>
</mjml>
