---
subject: "New sign-in on {{child_name}}'s account"
vars: [child_name, device, location, time, ip]
---
<mjml>
  <mj-head>
    <mj-preview>New sign-in on {{child_name}}'s account</mj-preview>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{colors.background}}" width="560px">
    {{> header}}
    <mj-section background-color="{{colors.surface}}" border-radius="14px" padding="28px 8px">
      <mj-column>
        <mj-text color="{{colors.text}}" font-size="22px" font-weight="700" line-height="30px">New sign-in on {{child_name}}'s account</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">{{child_name}}'s account was just used to sign in from <strong>{{device}}</strong>, near <strong>{{location}}</strong>.</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">You can see and end their sessions from the family dashboard.</mj-text>

      </mj-column>
    </mj-section>
    {{> footer}}
  </mj-body>
</mjml>
