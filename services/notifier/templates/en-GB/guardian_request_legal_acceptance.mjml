---
subject: "Updated terms need your approval"
vars: [child_name, dashboard_url]
---
<mjml>
  <mj-head>
    <mj-preview>Updated terms need your approval</mj-preview>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{colors.background}}" width="560px">
    {{> header}}
    <mj-section background-color="{{colors.surface}}" border-radius="14px" padding="28px 8px">
      <mj-column>
        <mj-text color="{{colors.text}}" font-size="22px" font-weight="700" line-height="30px">Updated terms</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">Our terms have changed. As {{child_name}}'s guardian, please review and accept them.</mj-text>
        <mj-button href="{{dashboard_url}}" background-color="{{colors.primary}}" color="{{colors.primary_text}}" font-weight="600" border-radius="8px" align="left" inner-padding="12px 22px">Review terms</mj-button>
      </mj-column>
    </mj-section>
    {{> footer}}
  </mj-body>
</mjml>
