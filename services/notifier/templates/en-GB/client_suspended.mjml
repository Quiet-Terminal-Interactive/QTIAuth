---
subject: "Your app {{client_name}} was suspended"
vars: [name, client_name, reason]
---
<mjml>
  <mj-head>
    <mj-preview>Your app {{client_name}} was suspended</mj-preview>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{colors.background}}" width="560px">
    {{> header}}
    <mj-section background-color="{{colors.surface}}" border-radius="14px" padding="28px 8px">
      <mj-column>
        <mj-text color="{{colors.text}}" font-size="22px" font-weight="700" line-height="30px">App suspended</mj-text>
        <mj-text color="{{colors.text}}" font-size="16px" line-height="24px">Hi {{name}}, your app <strong>{{client_name}}</strong> was suspended: {{reason}}. Existing tokens were revoked and new sign-ins are blocked.</mj-text>

      </mj-column>
    </mj-section>
    {{> footer}}
  </mj-body>
</mjml>
