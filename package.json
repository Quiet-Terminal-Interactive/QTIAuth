{
  "name": "qtiauth",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "lint:literals": "node scripts/check-literals.ts",
    "config:schema": "node packages/config/src/bin/write-schema.ts",
    "qtiauth": "node packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "pg": "^8.16.3",
    "@types/pg": "^8.15.5",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@qtiauth/common": "workspace:*",
    "@qtiauth/config": "workspace:*",
    "@qtiauth/bus": "workspace:*",
    "@qtiauth/service-kit": "workspace:*",
    "@qtiauth/auth-context": "workspace:*",
    "@qtiauth/db": "workspace:*",
    "jose": "^6.2.12"
  }
}
