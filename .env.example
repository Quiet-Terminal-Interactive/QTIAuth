# QTIAuth secrets. Copy to .env and fill in. Everything that isn't a secret belongs in config/qtiauth.yaml.
# Generate keys with:  openssl rand -hex 32

# Encryption (required)
APP_ENCRYPTION_KEY=
KEY_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

# Infrastructure (required)
POSTGRES_PASSWORD=
IDENTITY_DB_PASSWORD=
NOTIFIER_DB_PASSWORD=
OIDC_DB_PASSWORD=
SAFETY_DB_PASSWORD=
SUPPORT_DB_PASSWORD=
GAMES_DB_PASSWORD=
NATS_PASSWORD=
ALTCHA_HMAC_KEY=

# Email (pick the provider in qtiauth.yaml)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_API_KEY=

# Object storage (storage profile, or any S3-compatible service)
S3_ACCESS_KEY_ID=qtiauth
S3_SECRET_ACCESS_KEY=

# Social sign-in (only for providers you enable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
STEAM_WEB_API_KEY=
STEAM_PUBLISHER_KEY=

# Optional profiles
MAXMIND_LICENSE_KEY=
GEOIP_SOURCE=dbip_lite
QTIAUTH_HOSTS=
ACME_EMAIL=
GRAFANA_ADMIN_PASSWORD=
# Required for Prometheus to scrape the gateway's /metrics (observability profile).
GATEWAY_METRICS_TOKEN=

# Alert delivery (observability profile; set any combination)
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_HOST=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_DISCORD_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK_URL=
ALERT_SLACK_CHANNEL=
ALERT_WEBHOOK_URL=

# Ports
HTTP_PORT=8080
