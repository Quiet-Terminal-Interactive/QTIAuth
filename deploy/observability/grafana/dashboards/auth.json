{
 "uid": "qtiauth-auth",
 "title": "QTIAuth \u00b7 Auth and sessions",
 "tags": [
  "qtiauth"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
