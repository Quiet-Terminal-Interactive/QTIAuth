  {
   "id": 1,
   "type": "timeseries",
   "title": "Sign-ins by method and result",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (method, result) (rate(qtiauth_auth_sign_ins_total[5m]))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
