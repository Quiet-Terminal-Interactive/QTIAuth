{
 "uid": "qtiauth-bus",
 "title": "QTIAuth \u00b7 Bus",
 "tags": [
  "qtiauth"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Published by subject",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(15, sum by (subject) (rate(qtiauth_bus_published_total[5m])))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Consumed by consumer",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(15, sum by (consumer) (rate(qtiauth_bus_consumed_total[5m])))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Consumer pending",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (consumer) (qtiauth_bus_consumer_pending)",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Redeliveries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (consumer) (rate(qtiauth_bus_redeliveries_total[5m]))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Outbox backlog",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (instance) (qtiauth_outbox_backlog)",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "RPC p95 by method",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(10, histogram_quantile(0.95, sum by (le, method) (rate(qtiauth_rpc_request_seconds_bucket[5m]))))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "RPC no-responders",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (method) (rate(qtiauth_rpc_no_responders_total[5m]))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "RPC timeouts",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (method) (rate(qtiauth_rpc_timeouts_total[5m]))",
     "legendFormat": "__auto"
    }
   ]
  }
 ]
}