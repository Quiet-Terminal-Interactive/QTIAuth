{
 "uid": "qtiauth-notifier",
 "title": "QTIAuth \u00b7 Notifier",
 "tags": [
  "qtiauth"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Emails by status",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(qtiauth_emails_total[5m]))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Emails by template",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(15, sum by (template) (increase(qtiauth_emails_total[1h])))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Send latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(qtiauth_email_send_seconds_bucket[5m])))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Bounces and suppressions",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(qtiauth_email_bounces_total[1h])) or vector(0)",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Webhook deliveries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (format, status) (rate(qtiauth_webhook_deliveries_total[5m]))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Webhook latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(qtiauth_webhook_delivery_seconds_bucket[5m])))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Auto-disabled endpoints",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(qtiauth_webhook_endpoints_disabled_total[1d]))",
     "legendFormat": "__auto"
    }
   ]
  }
 ]
}