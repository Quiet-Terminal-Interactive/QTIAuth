{
 "uid": "qtiauth-safety",
 "title": "QTIAuth \u00b7 Safety",
 "tags": [
  "qtiauth"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Reports by type",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (type, source) (increase(qtiauth_safety_reports_total[1d]))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Queue depth by priority",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (priority) (qtiauth_safety_queue_depth)",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Time to first action p50",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
