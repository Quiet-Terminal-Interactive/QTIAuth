     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, type) (rate(qtiauth_safety_time_to_action_seconds_bucket[1d])))",
     "legendFormat": "__auto"
    }
   ]
  },
