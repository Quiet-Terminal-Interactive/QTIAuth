{
 "uid": "qtiauth-infra",
 "title": "QTIAuth \u00b7 Infra",
 "tags": [
  "qtiauth"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Service HTTP p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(qtiauth_service_http_seconds_bucket[5m])))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
