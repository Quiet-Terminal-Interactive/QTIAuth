{
 "uid": "qtiauth-gateway",
 "title": "QTIAuth \u00b7 Gateway",
 "tags": [
  "qtiauth"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests by route",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(15, sum by (route) (rate(qtiauth_gateway_requests_total[5m])))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Status codes",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(qtiauth_gateway_requests_total[5m]))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "p95 latency by route",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(10, histogram_quantile(0.95, sum by (le, route) (rate(qtiauth_gateway_request_seconds_bucket[5m]))))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Upstream errors by service",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (rate(qtiauth_gateway_upstream_errors_total[5m]))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Upstream p95 by service",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(qtiauth_gateway_upstream_seconds_bucket[5m])))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Rate-limit rejections by policy",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (policy) (rate(qtiauth_rate_limit_checks_total{result=\"rejected\"}[5m]))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Valkey failures",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(qtiauth_rate_limit_valkey_failures_total[5m]))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Request sizes p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(qtiauth_gateway_request_bytes_bucket[5m])))",
     "legendFormat": "__auto"
    }
   ]
  }
 ]
}